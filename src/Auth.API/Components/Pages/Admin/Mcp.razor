@page "/Admin/Mcp"
@attribute [Authorize(Roles = "Admin")]
@using Auth.API.Options
@using Microsoft.Extensions.Options
@inject IOptionsSnapshot<McpOptions> McpOptions
@inject NavigationManager Nav

<PageTitle>MCP — undervisning &amp; drift</PageTitle>

<div class="merc-page merc-mcp">
    <header class="merc-mcp__hero">
        <div class="merc-mcp__hero-copy">
            <p class="merc-mcp__eyebrow">Cursor · Model Context Protocol · undervisning</p>
            <h1>Når AI’en får nøgler til Auth</h1>
            <p class="merc-mcp__lead">
                MCP er broen mellem chatten og denne platform: i stedet for at elever (eller du) klikker rundt i Admin,
                kan Cursor kalde navngivne <em>tools</em> — oprette OAuth-klienter, hente manifestet, liste brugere —
                med samme API-nøgle-mønster som Dokploy.
            </p>
            <div class="merc-mcp__hero-actions">
                <a class="merc-btn merc-btn--primary" href="https://auth-spa.mercantec.tech/mcp.html" target="_blank" rel="noopener">
                    Elev-side (SPA) →
                </a>
                <a class="merc-btn merc-btn--ghost" href="/.well-known/mercantec-auth.json" target="_blank" rel="noopener">Manifest</a>
                <a class="merc-btn merc-btn--ghost" href="/Admin/Clients">Klienter</a>
            </div>
        </div>
        <aside class="merc-mcp__hero-aside" aria-label="Serverstatus">
            <p class="merc-mcp__aside-title">Drift lige nu</p>
            <dl class="merc-mcp__status-dl">
                <div>
                    <dt>API-nøgle</dt>
                    <dd>
                        @if (_apiKeyConfigured)
                        {
                            <span class="merc-mcp__pill merc-mcp__pill--ok">Konfigureret</span>
                        }
                        else
                        {
                            <span class="merc-mcp__pill merc-mcp__pill--warn">Mangler</span>
                        }
                    </dd>
                </div>
                <div>
                    <dt>Header</dt>
                    <dd><code>x-api-key</code></dd>
                </div>
                <div>
                    <dt>Base</dt>
                    <dd><code class="merc-mcp__break">@_baseUrl</code></dd>
                </div>
            </dl>
            @if (!_apiKeyConfigured)
            {
                <p class="merc-hint">Sæt <code>Mcp__ApiKey</code> i Dokploy (= <code>AUTH_MCP_API_KEY</code> i Cursor).</p>
            }
            else
            {
                <p class="merc-hint">Nøglen er live — behandle den som root.</p>
            }
        </aside>
    </header>

    <nav class="merc-mcp__toc" aria-label="Indhold på siden">
        <span class="merc-mcp__toc-label">Spring til</span>
        <a href="#fortælling">Fortælling</a>
        <a href="#flow">Flow</a>
        <a href="#pensum">Pensum / tools</a>
        <a href="#workshop">Workshop</a>
        <a href="#opsætning">Opsætning</a>
        <a href="#sikkerhed">Sikkerhed</a>
    </nav>

    <section class="merc-panel merc-mcp__story" id="fortælling" aria-labelledby="story-h">
        <div class="merc-panel__head">
            <h2 id="story-h">To historier, én platform</h2>
            <p class="merc-panel__sub">Hjælp eleverne til at skelne «skriv kode» fra «kald platformen»</p>
        </div>
        <div class="merc-mcp__compare">
            <article class="merc-mcp__compare-card merc-mcp__compare-card--prompt">
                <h3>AI-prompt</h3>
                <p>Lærer AI’en at <strong>skrive</strong> korrekt PKCE, token-exchange og JWT-validering.</p>
                <p class="merc-hint">Elev-værktøj: SPA → AI-prompt</p>
            </article>
            <article class="merc-mcp__compare-card merc-mcp__compare-card--mcp">
                <h3>MCP</h3>
                <p>Giver AI’en <strong>tools</strong>, så den kan oprette klienter og læse Auth — ikke bare beskrive det.</p>
                <p class="merc-hint">Samme sandhed som denne admin-UI</p>
            </article>
        </div>
        <div class="merc-mcp__callout">
            <strong>Kernen til tavlen:</strong> MCP er ikke magi. Det er HTTPS + en API-nøgle + pæne funktionsnavne.
            Hvis I forstår <code>/api/admin/clients</code>, forstår I <code>auth_create_client</code>.
        </div>
    </section>

    <section class="merc-panel" id="flow" aria-labelledby="flow-h">
        <div class="merc-panel__head">
            <h2 id="flow-h">Fire hop fra chat til database</h2>
        </div>
        <ol class="merc-mcp__pipeline">
            <li>
                <span class="merc-mcp__pipe-num">1</span>
                <div>
                    <strong>Cursor</strong>
                    <p>Agenten vælger et tool, fx <code>auth_add_redirect_uri</code>.</p>
                </div>
            </li>
            <li>
                <span class="merc-mcp__pipe-num">2</span>
                <div>
                    <strong>MCP stdio</strong>
                    <p>Lokal Node-proces (<code>mcp/build/index.js</code>) oversætter til fetch.</p>
                </div>
            </li>
            <li>
                <span class="merc-mcp__pipe-num">3</span>
                <div>
                    <strong>Auth.API</strong>
                    <p>Godkender <code>x-api-key</code> (eller Admin-JWT) på <code>/api/admin/*</code>.</p>
                </div>
            </li>
            <li>
                <span class="merc-mcp__pipe-num">4</span>
                <div>
                    <strong>Postgres</strong>
                    <p>Samme <code>ClientApps</code> / brugere som Blazor-admin ser.</p>
                </div>
            </li>
        </ol>
    </section>

    <section class="merc-panel" id="pensum" aria-labelledby="pensum-h">
        <div class="merc-panel__head">
            <h2 id="pensum-h">Pensumkort — tools i v1</h2>
            <p class="merc-panel__sub">Tre fag. Discovery først, admin når nøglen er på plads.</p>
        </div>
        <div class="merc-mcp__tool-groups">
            <article class="merc-mcp__tool-card">
                <span class="merc-mcp__tool-badge">Offentlig</span>
                <h3>Discovery</h3>
                <p class="merc-hint">Første øvelse i timen</p>
                <ul>
                    <li><code>auth_health</code></li>
                    <li><code>auth_get_openid_configuration</code></li>
                    <li><code>auth_get_manifest</code></li>
                </ul>
            </article>
            <article class="merc-mcp__tool-card">
                <span class="merc-mcp__tool-badge merc-mcp__tool-badge--key">API-nøgle</span>
                <h3>OAuth-klienter</h3>
                <p class="merc-hint">Det I ellers gør under Klienter</p>
                <ul>
                    <li><code>auth_list_clients</code> / <code>get</code></li>
                    <li><code>auth_create_client</code> / <code>update</code> / <code>delete</code></li>
                    <li><code>auth_add_redirect_uri</code> / <code>remove</code></li>
                    <li><code>auth_rotate_client_secret</code></li>
                </ul>
            </article>
            <article class="merc-mcp__tool-card">
                <span class="merc-mcp__tool-badge merc-mcp__tool-badge--key">API-nøgle</span>
                <h3>Brugere &amp; usage</h3>
                <p class="merc-hint">Directory, merge, forbrug</p>
                <ul>
                    <li><code>auth_users_directory</code></li>
                    <li><code>auth_merge_users</code> / <code>auth_delete_user</code></li>
                    <li><code>auth_usage_summary</code> / <code>events</code></li>
                </ul>
            </article>
        </div>
    </section>

    <section class="merc-panel merc-mcp__workshop" id="workshop" aria-labelledby="workshop-h">
        <div class="merc-panel__head">
            <h2 id="workshop-h">Workshop-prompts (klar til tavlen)</h2>
            <p class="merc-panel__sub">Kopiér ind i Cursor — start med A uden nøgle</p>
        </div>
        <div class="merc-mcp__exercises">
            <article>
                <span class="merc-mcp__ex-label">A · Discovery</span>
                <pre class="merc-mcp__ex-pre">Brug Mercantec Auth MCP: kør auth_health og auth_get_manifest.
Opsummér issuer, audience og mcp-blokkens krav til x-api-key.</pre>
            </article>
            <article>
                <span class="merc-mcp__ex-label">B · Ny klient</span>
                <pre class="merc-mcp__ex-pre">Opret offentlig OAuth-klient med PKCE.
client_id: workshop-XXXX — tilføj redirect https://localhost:5173/callback
Vis klienten med auth_get_client.</pre>
            </article>
            <article>
                <span class="merc-mcp__ex-label">C · Wire SPA</span>
                <pre class="merc-mcp__ex-pre">Jeg har client_id workshop-XXXX. Hent manifestet og generér
minimal Vite PKCE-login med den præcise redirect_uri.</pre>
            </article>
        </div>
        <p class="merc-hint merc-hint--block">
            Efter timen: slet workshop-klienter under <a href="/Admin/Clients">Klienter</a> eller via <code>auth_delete_client</code>.
            Elev-materiale med mermaid-flow: <a href="https://auth-spa.mercantec.tech/mcp.html" target="_blank" rel="noopener">auth-spa …/mcp.html</a>.
        </p>
    </section>

    <section class="merc-panel" id="opsætning" aria-labelledby="setup-h">
        <div class="merc-panel__head">
            <h2 id="setup-h">Opsætning (lærer / drift)</h2>
        </div>
        <ol class="merc-mcp__steps">
            <li>Byg pakken: <code>cd mcp &amp;&amp; npm install &amp;&amp; npm run build</code></li>
            <li>Dokploy Auth: <code>Mcp__ApiKey=&lt;stærk-nøgle&gt;</code> (allerede sat i prod hvis I fulgte MCP-udrulningen).</li>
            <li>Cursor <code>mcp.json</code> — se eksempel nedenfor. Genstart MCP-serveren.</li>
        </ol>
        <pre class="merc-mcp__code" tabindex="0"><code>@_mcpJsonExample</code></pre>
    </section>

    <section class="merc-panel" id="sikkerhed" aria-labelledby="sec-h">
        <div class="merc-panel__head">
            <h2 id="sec-h">Sikkerhed i undervisningen</h2>
        </div>
        <div class="merc-mcp__compare">
            <article class="merc-mcp__compare-card merc-mcp__compare-card--bad">
                <h3>Gør ikke</h3>
                <ul>
                    <li>Commit nøglen til git</li>
                    <li>Del nøglen i elev-chats</li>
                    <li>Lad AI slette brugere “for sjov”</li>
                </ul>
            </article>
            <article class="merc-mcp__compare-card merc-mcp__compare-card--good">
                <h3>Gør</h3>
                <ul>
                    <li>Behandl nøglen som root</li>
                    <li>Brug <code>workshop-</code>-præfiks på client_id</li>
                    <li>Ryd midlertidige klienter efter timen</li>
                </ul>
            </article>
        </div>
        <ul class="merc-mcp__bullets">
            <li>Admin-UI her bruger cookie + rolle; MCP bruger <code>x-api-key</code> — begge rammer samme admin-API.</li>
            <li>Client secrets vises kun ved create/rotate — gem dem med det samme.</li>
            <li>Dokploy-ACL via MCP er ikke i v1 — brug <a href="/Admin/Dokploy">Dokploy-admin</a>.</li>
        </ul>
    </section>
</div>

@code {
    private bool _apiKeyConfigured;
    private string _baseUrl = "";
    private string _mcpJsonExample = "";

    protected override void OnInitialized()
    {
        _apiKeyConfigured = !string.IsNullOrWhiteSpace(McpOptions.Value.ApiKey);
        _baseUrl = Nav.BaseUri.TrimEnd('/');
        _mcpJsonExample =
            """
            {
              "mcpServers": {
                "mercantec-auth": {
                  "command": "node",
                  "args": ["<sti-til-repo>/mcp/build/index.js"],
                  "env": {
                    "AUTH_BASE_URL": "https://auth.mercantec.tech",
                    "AUTH_MCP_API_KEY": "${env:AUTH_MCP_API_KEY}"
                  }
                }
              }
            }
            """;
    }
}
