@page "/Admin/Users"
@attribute [Authorize(Roles = "Admin")]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Auth.API.Services
@inject AuthDbContext Db
@inject IAccountMergeService Merge
@inject IUserDeletionService UserDeletion
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime Js
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop

<PageTitle>Brugere (admin)</PageTitle>

<div class="merc-page merc-users">
    <header class="merc-users__header">
        <div>
            <h1>Brugere</h1>
            <p class="merc-users__lead">
                Sortér og filtrér brugere efter oprettelsesplatform, eller slet en konto.
                Sammenlægning kan slås til efter behov. Se også <a href="/Admin/Usage">Auth-brug</a> for klient- og login-sporing.
            </p>
        </div>
        <a class="merc-btn merc-btn--ghost" href="/Admin/Usage">Auth-brug →</a>
    </header>

    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <div class="merc-alert @(_statusIsError ? "merc-alert--error" : "merc-alert--ok")" role="status">
            @_status
        </div>
    }

    @if (_rows is null)
    {
        <p class="merc-users__loading">Henter…</p>
    }
    else
    {
        var visibleRows = GetVisibleRows();
        var providerStats = GetProviderStats(visibleRows);
        var oauthStats = GetOAuthStats(visibleRows);

        <section class="merc-panel merc-users__toolbar" aria-label="Visningsindstillinger">
            <div class="merc-users__filters">
                <label class="merc-users__filter">
                    <span>Oprettelsesplatform</span>
                    <select class="merc-input merc-users__select" @bind="PlatformFilter">
                        <option value="">Alle platforme</option>
                        @if (_rows.Any(r => r.CreatedViaClientId is null))
                        {
                            <option value="@DirectPlatformFilter">Direkte / ældre konto</option>
                        }
                        @foreach (var platform in PlatformOptions())
                        {
                            <option value="@platform.ClientId">@platform.Label</option>
                        }
                    </select>
                </label>

                <label class="merc-users__toggle">
                    <input type="checkbox" role="switch" @bind="MergeModeEnabled" />
                    <span class="merc-users__toggle-track" aria-hidden="true"></span>
                    <span class="merc-users__toggle-label">Sammenlæg brugere</span>
                </label>
            </div>
            <p class="merc-users__count" aria-live="polite">
                Viser <strong>@visibleRows.Count</strong> af <strong>@_rows.Count</strong> @(_rows.Count == 1 ? "bruger" : "brugere")
            </p>
        </section>

        <section class="merc-users__stats" aria-labelledby="users-stats-heading">
            <div class="merc-users__stats-heading">
                <div>
                    <h2 id="users-stats-heading">Statistik</h2>
                    <p>Baseret på de @visibleRows.Count viste brugere. En bruger kan have flere login-providers og OAuth-klienter.</p>
                </div>
            </div>

            <div class="merc-users__stats-grid">
                <article class="merc-panel merc-users__stat-card">
                    <header class="merc-users__stat-card-heading">
                        <div>
                            <span class="merc-users__stat-eyebrow">Login</span>
                            <h3>Providers</h3>
                        </div>
                        @{ var providerConnectionCount = providerStats.Sum(p => p.UserCount); }
                        <span class="merc-users__stat-total">@providerConnectionCount @(providerConnectionCount == 1 ? "forbindelse" : "forbindelser")</span>
                    </header>

                    @if (providerStats.Count == 0)
                    {
                        <p class="merc-hint">Ingen login-providers blandt de viste brugere.</p>
                    }
                    else
                    {
                        <ul class="merc-users__provider-stats" role="list">
                            @foreach (var provider in providerStats)
                            {
                                <li>
                                    <span class="merc-users__provider-logo merc-users__provider-logo--@ProviderCssKey(provider.Key)">
                                        <ProviderLogo Provider="@provider.Key" />
                                    </span>
                                    <span class="merc-users__provider-info">
                                        <span class="merc-users__provider-row">
                                            <strong>@provider.Label</strong>
                                            <span>@provider.UserCount @(provider.UserCount == 1 ? "bruger" : "brugere")</span>
                                        </span>
                                        <span class="merc-users__provider-bar" aria-hidden="true">
                                            <span style="@ShareStyle(provider.UserCount, visibleRows.Count)"></span>
                                        </span>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </article>

                <article class="merc-panel merc-users__stat-card">
                    <header class="merc-users__stat-card-heading">
                        <div>
                            <span class="merc-users__stat-eyebrow">Apps</span>
                            <h3>OAuth-klienter</h3>
                        </div>
                        <span class="merc-users__stat-total">@oauthStats.Count @(oauthStats.Count == 1 ? "klient" : "klienter")</span>
                    </header>

                    @if (oauthStats.Count == 0)
                    {
                        <p class="merc-hint">Ingen OAuth-brug blandt de viste brugere.</p>
                    }
                    else
                    {
                        <ul class="merc-users__oauth-stats" role="list">
                            @foreach (var client in oauthStats)
                            {
                                <li>
                                    <span class="merc-users__provider-logo merc-users__provider-logo--oauth">
                                        <ProviderLogo Provider="oauth" />
                                    </span>
                                    <span class="merc-users__oauth-info">
                                        <span class="merc-users__oauth-name">
                                            <strong>@client.Name</strong>
                                            <code>@client.ClientId</code>
                                        </span>
                                        <span class="merc-users__oauth-users">@client.DistinctUsers @(client.DistinctUsers == 1 ? "bruger" : "brugere")</span>
                                        <span class="merc-users__oauth-events">
                                            <span title="Authorize-kald"><strong>@client.AuthorizeCount</strong> authorize</span>
                                            <span title="Token-udvekslinger"><strong>@client.TokenExchangeCount</strong> token</span>
                                            <span title="Refresh-kald"><strong>@client.RefreshCount</strong> refresh</span>
                                        </span>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </article>
            </div>
        </section>

        @if (_mergeModeEnabled)
        {
            <section class="merc-panel merc-users__merge-panel" aria-labelledby="merge-heading">
                <h2 id="merge-heading" class="merc-users__panel-title">Sammenlæg to brugere</h2>
                <p class="merc-hint merc-hint--block">
                    Marker <strong>hovedkonto</strong> (JWT <code>sub</code> beholdes) og <strong>konto der nedlægges</strong>.
                    Alle login fra den nedlagte flyttes til hovedkontoen. Se dokumentation for overlap (lokalt login, e-mail-typer).
                </p>
                <div class="merc-users__merge-actions">
                    <button type="button" class="merc-btn merc-btn--primary" @onclick="MergeAsync" disabled="@(_mergeBusy || !_mergeReady)">
                        @(_mergeBusy ? "Sammenlægger…" : "Udfør sammenlægning")
                    </button>
                    <button type="button" class="merc-btn merc-btn--ghost" @onclick="ClearMergeSelection" disabled="@_mergeBusy">Nulstil valg</button>
                </div>
            </section>
        }

        @if (visibleRows.Count == 0)
        {
            <div class="merc-panel merc-users__empty">
                Ingen brugere matcher det valgte filter.
            </div>
        }
        else
        {
            <div class="merc-users__table-wrap">
            <table class="table table-sm merc-users__table">
                <thead>
                <tr>
                    @if (_mergeModeEnabled)
                    {
                        <th class="merc-users__th-radio" scope="col">Beholde<br/><span class="merc-users__th-sub">(sub)</span></th>
                        <th class="merc-users__th-radio" scope="col">Nedlægges<br/><span class="merc-users__th-sub">(donor)</span></th>
                    }
                    <th scope="col" aria-sort="@SortAria(UserSort.Name)">@SortButton("Navn", UserSort.Name)</th>
                    <th scope="col" aria-sort="@SortAria(UserSort.Email)">@SortButton("E-mail", UserSort.Email)</th>
                    <th scope="col" aria-sort="@SortAria(UserSort.CreatedAt)">@SortButton("Oprettet", UserSort.CreatedAt)</th>
                    <th scope="col" aria-sort="@SortAria(UserSort.Platform)">@SortButton("Platform", UserSort.Platform)</th>
                    <th scope="col" aria-sort="@SortAria(UserSort.Providers)">@SortButton("Providers", UserSort.Providers)</th>
                    <th scope="col" aria-sort="@SortAria(UserSort.TwoFactor)">@SortButton("2FA", UserSort.TwoFactor)</th>
                    <th scope="col" aria-sort="@SortAria(UserSort.Clients)">@SortButton("OAuth-klienter", UserSort.Clients)</th>
                    <th scope="col" aria-sort="@SortAria(UserSort.Roles)">@SortButton("Roller", UserSort.Roles)</th>
                    <th scope="col" aria-sort="@SortAria(UserSort.Status)">@SortButton("Status", UserSort.Status)</th>
                    <th scope="col" class="merc-users__th-actions">Handling</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var r in visibleRows)
                {
                    <tr>
                        @if (_mergeModeEnabled)
                        {
                            <td class="merc-users__td-radio">
                                <input type="radio" name="merc-merge-survivor"
                                       checked="@(_survivorId == r.Id)"
                                       @onchange="@(_ => PickSurvivor(r.Id))"
                                       aria-label="Bevare @r.DisplayName" />
                            </td>
                            <td class="merc-users__td-radio">
                                <input type="radio" name="merc-merge-donor"
                                       checked="@(_donorId == r.Id)"
                                       @onchange="@(_ => PickDonor(r.Id))"
                                       aria-label="Nedlæg @r.DisplayName" />
                            </td>
                        }
                        <td>
                            <span class="merc-users__name">@r.DisplayName</span>
                            <code class="merc-users__id" title="@r.Id.ToString()">@ShortId(r.Id)</code>
                        </td>
                        <td>@(r.Email ?? "—")</td>
                        <td class="merc-users__date" title="@FormatCreatedAtUtc(r.CreatedAt)">@FormatCreatedAt(r.CreatedAt)</td>
                        <td class="merc-users__meta-cell">@r.PlatformLabel</td>
                        <td class="merc-users__meta-cell">@FormatProviders(r)</td>
                        <td class="merc-users__meta-cell">@r.TwoFactor</td>
                        <td class="merc-users__meta-cell">@FormatClients(r)</td>
                        <td>@r.Roles</td>
                        <td>
                            @if (r.IsDisabled)
                            {
                                <span class="merc-badge merc-badge--muted">Deaktiveret</span>
                            }
                            else
                            {
                                <span class="merc-badge merc-badge--ok">Aktiv</span>
                            }
                        </td>
                        <td class="merc-users__actions">
                            <button type="button"
                                    class="merc-btn merc-btn--danger merc-btn--sm"
                                    disabled="@(_deleteBusy || r.Id == _myUserId)"
                                    title="@(r.Id == _myUserId ? "Du kan ikke slette dig selv her." : "")"
                                    @onclick="@(() => DeleteRowAsync(r))">
                                Slet
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
        }
    }
</div>

@code {
    private List<Row>? _rows;
    private Guid _myUserId;
    private Guid? _survivorId;
    private Guid? _donorId;
    private string? _status;
    private bool _statusIsError;
    private bool _mergeBusy;
    private bool _deleteBusy;
    private bool _mergeModeEnabled;
    private string _platformFilter = string.Empty;
    private UserSort _sort = UserSort.CreatedAt;
    private bool _sortDescending = true;
    private IReadOnlyDictionary<string, string> _clientNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

    private const string DirectPlatformFilter = "__direct_or_legacy__";

    private bool _mergeReady =>
        _survivorId is { } sv && _donorId is { } dn && sv != dn;

    private bool MergeModeEnabled
    {
        get => _mergeModeEnabled;
        set
        {
            _mergeModeEnabled = value;
            if (!value)
                ClearMergeSelection();
        }
    }

    private string PlatformFilter
    {
        get => _platformFilter;
        set
        {
            _platformFilter = value;
            _survivorId = null;
            _donorId = null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadActorAsync();
        await ReloadUsersAsync();
    }

    private async Task LoadActorAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var sub = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        _ = Guid.TryParse(sub, out _myUserId);
    }

    private static string ShortId(Guid id)
    {
        var s = id.ToString();
        return s[..8] + "…";
    }

    private IReadOnlyList<Row> GetVisibleRows()
    {
        IEnumerable<Row> rows = _rows ?? [];
        if (_platformFilter == DirectPlatformFilter)
            rows = rows.Where(r => r.CreatedViaClientId is null);
        else if (!string.IsNullOrWhiteSpace(_platformFilter))
            rows = rows.Where(r => string.Equals(r.CreatedViaClientId, _platformFilter, StringComparison.OrdinalIgnoreCase));

        IOrderedEnumerable<Row> orderedRows = _sort switch
        {
            UserSort.Name => OrderText(rows, r => r.DisplayName),
            UserSort.Email => OrderText(rows, r => r.Email ?? string.Empty),
            UserSort.CreatedAt => Order(rows, r => r.CreatedAt),
            UserSort.Platform => OrderText(rows, r => r.PlatformLabel),
            UserSort.Providers => OrderText(rows, FormatProviders),
            UserSort.TwoFactor => OrderText(rows, r => r.TwoFactor),
            UserSort.Clients => OrderText(rows, FormatClients),
            UserSort.Roles => OrderText(rows, r => r.Roles),
            UserSort.Status => Order(rows, r => r.IsDisabled),
            _ => rows.OrderBy(r => r.DisplayName, StringComparer.OrdinalIgnoreCase),
        };

        return orderedRows.ThenBy(r => r.DisplayName, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private IOrderedEnumerable<Row> Order<TKey>(IEnumerable<Row> rows, Func<Row, TKey> keySelector) =>
        _sortDescending
            ? rows.OrderByDescending(keySelector, Comparer<TKey>.Default)
            : rows.OrderBy(keySelector, Comparer<TKey>.Default);

    private IOrderedEnumerable<Row> OrderText(IEnumerable<Row> rows, Func<Row, string> keySelector) =>
        _sortDescending
            ? rows.OrderByDescending(keySelector, StringComparer.CurrentCultureIgnoreCase)
            : rows.OrderBy(keySelector, StringComparer.CurrentCultureIgnoreCase);

    private IReadOnlyList<PlatformOption> PlatformOptions() => (_rows ?? [])
        .Where(r => r.CreatedViaClientId is not null)
        .GroupBy(r => r.CreatedViaClientId!, StringComparer.OrdinalIgnoreCase)
        .Select(g => new PlatformOption(g.Key, g.First().PlatformLabel))
        .OrderBy(p => p.Label, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private static IReadOnlyList<ProviderStat> GetProviderStats(IEnumerable<Row> rows) => rows
        .SelectMany(r => ProviderKeys(r).Distinct(StringComparer.OrdinalIgnoreCase))
        .GroupBy(provider => provider, StringComparer.OrdinalIgnoreCase)
        .Select(g => new ProviderStat(g.Key, ProviderLabel(g.Key), g.Count()))
        .OrderByDescending(p => p.UserCount)
        .ThenBy(p => p.Label, StringComparer.CurrentCultureIgnoreCase)
        .ToList();

    private static IEnumerable<string> ProviderKeys(Row row)
    {
        if (row.LocalLogin)
            yield return "password";

        foreach (var provider in row.ExternalLogins.Select(e => e.Provider))
            yield return provider;
    }

    private IReadOnlyList<OAuthStat> GetOAuthStats(IEnumerable<Row> rows) => rows
        .SelectMany(row => row.ClientUsages.Select(usage => new { row.Id, Usage = usage }))
        .GroupBy(x => x.Usage.ClientId, StringComparer.OrdinalIgnoreCase)
        .Select(g => new OAuthStat(
            g.Key,
            ClientName(g.Key),
            g.Select(x => x.Id).Distinct().Count(),
            g.Sum(x => x.Usage.AuthorizeCount),
            g.Sum(x => x.Usage.TokenExchangeCount),
            g.Sum(x => x.Usage.RefreshCount)))
        .OrderByDescending(c => c.DistinctUsers)
        .ThenBy(c => c.Name, StringComparer.CurrentCultureIgnoreCase)
        .ToList();

    private string ClientName(string clientId) =>
        _clientNames.TryGetValue(clientId, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : clientId;

    private static string ProviderLabel(string provider) => provider.Trim().ToLowerInvariant() switch
    {
        "password" => "E-mail / adgangskode",
        "google" => "Google",
        "microsoft" => "Microsoft 365",
        "microsoft-edu" => "Microsoft skolemail",
        "github" => "GitHub",
        "discord" => "Discord",
        _ => provider,
    };

    private static string ProviderCssKey(string provider) => provider.Trim().ToLowerInvariant() switch
    {
        "microsoft-edu" => "microsoft",
        "google" or "microsoft" or "github" or "discord" or "password" => provider.Trim().ToLowerInvariant(),
        _ => "other",
    };

    private static string ShareStyle(int count, int total)
    {
        var percentage = total == 0 ? 0 : Math.Round(count * 100d / total, 1);
        return $"width: {percentage.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%";
    }

    private void SetSort(UserSort sort)
    {
        if (_sort == sort)
            _sortDescending = !_sortDescending;
        else
        {
            _sort = sort;
            _sortDescending = sort == UserSort.CreatedAt;
        }
    }

    private string? SortAria(UserSort sort) =>
        _sort != sort ? null : _sortDescending ? "descending" : "ascending";

    private RenderFragment SortButton(string label, UserSort sort) => builder =>
    {
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "class", $"merc-users__sort{(_sort == sort ? " merc-users__sort--active" : string.Empty)}");
        builder.AddAttribute(3, "onclick", EventCallback.Factory.Create(this, () => SetSort(sort)));
        builder.AddContent(4, label);
        builder.OpenElement(5, "span");
        builder.AddAttribute(6, "aria-hidden", "true");
        builder.AddContent(7, _sort == sort ? (_sortDescending ? "↓" : "↑") : string.Empty);
        builder.CloseElement();
        builder.CloseElement();
    };

    private void PickSurvivor(Guid id)
    {
        _survivorId = id;
        if (_donorId == id)
            _donorId = null;
        SetStatus("", false);
    }

    private void PickDonor(Guid id)
    {
        _donorId = id;
        if (_survivorId == id)
            _survivorId = null;
        SetStatus("", false);
    }

    private void ClearMergeSelection()
    {
        _survivorId = null;
        _donorId = null;
        SetStatus("", false);
    }

    private void SetStatus(string message, bool isError)
    {
        _status = message;
        _statusIsError = isError;
    }

    private async Task ReloadUsersAsync()
    {
        _clientNames = await Db.ClientApps
            .AsNoTracking()
            .ToDictionaryAsync(c => c.ClientId, c => c.Name, StringComparer.OrdinalIgnoreCase);

        var users = await Db.Users
            .AsNoTracking()
            .Include(u => u.UserRoles)
            .ThenInclude(ur => ur.Role)
            .Include(u => u.ExternalLogins)
            .Include(u => u.ClientUsages)
            .Include(u => u.LocalLogin)
            .Include(u => u.TotpMfa)
            .OrderBy(u => u.DisplayName)
            .ToListAsync();

        var passkeyCounts = await Db.UserPasskeyCredentials
            .AsNoTracking()
            .GroupBy(c => c.UserId)
            .Select(g => new { g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.Key, x => x.Count);

        _rows = users.Select(u => new Row(
            u.Id,
            u.DisplayName,
            u.Email,
            u.CreatedAt,
            u.CreatedViaClientId,
            FormatPlatform(u.CreatedViaClientId, _clientNames),
            u.IsDisabled,
            string.Join(", ", u.UserRoles.Select(ur => ur.Role!.Name).OrderBy(n => n, StringComparer.OrdinalIgnoreCase)),
            u.ExternalLogins.OrderByDescending(e => e.LastUsedAtUtc ?? e.LinkedAt).ToList(),
            u.LocalLogin is not null,
            FormatTwoFactor(u.TotpMfa?.IsEnabled == true, passkeyCounts.GetValueOrDefault(u.Id)),
            u.ClientUsages.OrderByDescending(c => c.LastSeenAtUtc).ToList()))
            .ToList();
    }

    private static string FormatPlatform(string? clientId, IReadOnlyDictionary<string, string> clientNames)
    {
        if (clientId is null)
            return "Direkte / ældre konto";

        return clientNames.TryGetValue(clientId, out var name) && !string.IsNullOrWhiteSpace(name)
            ? $"{name} ({clientId})"
            : clientId;
    }

    private static string FormatCreatedAt(DateTime createdAt) => createdAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm");

    private static string FormatCreatedAtUtc(DateTime createdAt) => $"UTC: {createdAt.ToUniversalTime():yyyy-MM-dd HH:mm}";

    private static string FormatTwoFactor(bool totpEnabled, int passkeyCount)
    {
        var parts = new List<string>(2);
        if (totpEnabled)
            parts.Add("TOTP");
        if (passkeyCount > 0)
            parts.Add(passkeyCount == 1 ? "1 passkey" : $"{passkeyCount} passkeys");
        return parts.Count == 0 ? "—" : string.Join(", ", parts);
    }

    private static string FormatProviders(Row r)
    {
        var providers = ProviderKeys(r)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(ProviderLabel)
            .ToList();
        return providers.Count == 0 ? "—" : string.Join(", ", providers);
    }

    private static string FormatClients(Row r)
    {
        if (r.ClientUsages.Count == 0)
            return "—";
        return string.Join(", ", r.ClientUsages.Select(c => $"{c.ClientId} ({c.TokenExchangeCount} token)"));
    }

    private async Task MergeAsync()
    {
        if (!_mergeReady || _survivorId is null || _donorId is null)
            return;

        _mergeBusy = true;
        SetStatus("", false);
        try
        {
            var r = await Merge.MergeUsersAsync(_survivorId.Value, _donorId.Value);
            if (r.Success)
            {
                var w = r.Warnings.Count > 0
                    ? " Advarsler: " + string.Join(" ", r.Warnings)
                    : "";
                SetStatus($"Sammenlægning gennemført.{w}", r.Warnings.Count > 0);
                ClearMergeSelection();
                await ReloadUsersAsync();
            }
            else
            {
                var msg = r.Failure switch
                {
                    AccountMergeFailureReason.SameUser => "Vælg to forskellige brugere.",
                    AccountMergeFailureReason.SurvivorNotFound => "Hovedkonto blev ikke fundet.",
                    AccountMergeFailureReason.DonorNotFound => "Donor blev ikke fundet.",
                    AccountMergeFailureReason.SurvivorDisabled => "Hovedkonto er deaktiveret.",
                    _ => "Sammenlægning blev afvist.",
                };
                SetStatus(msg, true);
            }
        }
        finally
        {
            _mergeBusy = false;
        }
    }

    private async Task DeleteRowAsync(Row row)
    {
        if (row.Id == _myUserId)
            return;

        var confirm = await Js.InvokeAsync<bool>("confirm",
            $"Slet brugeren «{row.DisplayName}» permanent? Login, tokens og mails i auth fjernes. Det kan ikke fortrydes.");
        if (!confirm)
            return;

        _deleteBusy = true;
        SetStatus("", false);
        try
        {
            var r = await UserDeletion.DeleteUserAsync(row.Id, _myUserId);
            if (r.Success)
            {
                SetStatus($"Bruger «{row.DisplayName}» er slettet.", false);
                if (_survivorId == row.Id || _donorId == row.Id)
                    ClearMergeSelection();
                await ReloadUsersAsync();
            }
            else
            {
                var msg = r.Failure switch
                {
                    UserDeletionFailureReason.CannotDeleteSelf => "Du kan ikke slette dig selv.",
                    UserDeletionFailureReason.CannotDeleteLastAdmin =>
                        "Sidste Administrator må ikke fjernes — tilføj først Admin til en anden konto.",
                    UserDeletionFailureReason.NotFound => "Brugeren findes ikke (måske allerede slettet?).",
                    _ => "Sletning blev afvist.",
                };
                SetStatus(msg, true);
            }
        }
        finally
        {
            _deleteBusy = false;
        }
    }

    private sealed record Row(
        Guid Id,
        string DisplayName,
        string? Email,
        DateTime CreatedAt,
        string? CreatedViaClientId,
        string PlatformLabel,
        bool IsDisabled,
        string Roles,
        IReadOnlyList<Auth.API.Models.Entities.ExternalLogin> ExternalLogins,
        bool LocalLogin,
        string TwoFactor,
