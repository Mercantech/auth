@page "/Admin/Usage"
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<AuthDbContext> DbFactory
@using Auth.API.Models.Entities
@using Auth.API.Services
@using Microsoft.EntityFrameworkCore

<PageTitle>Auth-brug (admin)</PageTitle>

<div class="merc-page merc-usage">
    <header class="merc-usage__header">
        <div>
            <h1>Auth-brug</h1>
            <p class="merc-usage__lead">
                Overblik over login-providers, OAuth-klienter og hændelser på tværs af auth-platformen.
                Statistikken dækker de seneste 30 dage, mens klienttallene er akkumulerede.
            </p>
        </div>
        <div class="merc-usage__header-actions">
            <button type="button" class="merc-btn merc-btn--ghost" @onclick="ReloadAsync" disabled="@_isRefreshing">
                @(_isRefreshing ? "Opdaterer…" : "↻ Opdatér")
            </button>
            <a class="merc-btn merc-btn--ghost" href="/Admin/Users">← Brugere</a>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="merc-alert merc-alert--error" role="alert">
            <p><strong>Kunne ikke hente brugsdata.</strong> @_error</p>
            <p class="merc-hint">Tjek at migration <code>AuthUsageTracking</code> er kørt mod databasen. Brugerlisten kan stadig vise klienter fra <code>UserClientUsages</code>.</p>
            <button type="button" class="merc-btn merc-btn--ghost" @onclick="RetryAsync">Prøv igen</button>
        </div>
    }
    else if (_summary is null)
    {
        <p class="merc-usage__loading">Henter…</p>
    }
    else
    {
        <section class="merc-usage__kpis" aria-label="Nøgletal for de seneste 30 dage">
            <article class="merc-panel merc-usage__kpi">
                <span class="merc-usage__kpi-icon" aria-hidden="true">●</span>
                <span class="merc-usage__stat-value">@_summary.ActiveUsers30</span>
                <span class="merc-usage__stat-label">aktive brugere</span>
                <span class="merc-usage__stat-period">Seneste 30 dage</span>
            </article>
            <article class="merc-panel merc-usage__kpi">
                <span class="merc-usage__kpi-icon merc-usage__kpi-icon--warm" aria-hidden="true">↗</span>
                <span class="merc-usage__stat-value">@_summary.TotalEvents30</span>
                <span class="merc-usage__stat-label">auth-hændelser</span>
                <span class="merc-usage__stat-period">Seneste 30 dage</span>
            </article>
            <article class="merc-panel merc-usage__kpi">
                <span class="merc-usage__kpi-icon merc-usage__kpi-icon--provider" aria-hidden="true">@_summary.ByProvider.Count</span>
                <span class="merc-usage__stat-value">@_summary.ByProvider.Sum(p => p.LoginCount)</span>
                <span class="merc-usage__stat-label">provider-logins</span>
                <span class="merc-usage__stat-period">@_summary.ByProvider.Count aktive login-metoder</span>
            </article>
            <article class="merc-panel merc-usage__kpi">
                <span class="merc-usage__kpi-icon merc-usage__kpi-icon--oauth" aria-hidden="true">O</span>
                <span class="merc-usage__stat-value">@_summary.ByClient.Count</span>
                <span class="merc-usage__stat-label">OAuth-klienter</span>
                <span class="merc-usage__stat-period">Med registreret brug</span>
            </article>
        </section>

        <div class="merc-usage__overview-grid">
            <section class="merc-panel merc-usage__panel" aria-labelledby="providers-heading">
                <header class="merc-usage__section-heading">
                    <div>
                        <span class="merc-usage__eyebrow">Login</span>
                        <h2 id="providers-heading">Providers</h2>
                    </div>
                    <span class="merc-usage__heading-meta">30 dage</span>
                </header>

                @if (_summary.ByProvider.Count == 0)
                {
                    <p class="merc-hint">Ingen provider-logins i perioden.</p>
                }
                else
                {
                    <ul class="merc-usage__providers" role="list">
                        @foreach (var provider in _summary.ByProvider)
                        {
                            <li>
                                <span class="merc-users__provider-logo merc-users__provider-logo--@ProviderCssKey(provider.Key)">
                                    <ProviderLogo Provider="@provider.Key" />
                                </span>
                                <span class="merc-usage__provider-name">
                                    <strong>@provider.Label</strong>
                                    <span>@provider.DistinctUsers @(provider.DistinctUsers == 1 ? "bruger" : "brugere")</span>
                                </span>
                                <strong class="merc-usage__provider-count">@provider.LoginCount</strong>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="merc-panel merc-usage__panel" aria-labelledby="events-type-heading">
                <header class="merc-usage__section-heading">
                    <div>
                        <span class="merc-usage__eyebrow">Aktivitet</span>
                        <h2 id="events-type-heading">Hændelsestyper</h2>
                    </div>
                    <span class="merc-usage__heading-meta">30 dage</span>
                </header>

                @if (_summary.ByEventType.Count == 0)
                {
                    <p class="merc-hint">Ingen hændelser i perioden endnu.</p>
                }
                else
                {
                    <ul class="merc-usage__event-types" role="list">
                        @foreach (var e in _summary.ByEventType)
                        {
                            <li class="merc-usage__event-type merc-usage__event-type--@EventTypeCategory(e.EventType)">
                                <span>@EventTypeLabel(e.EventType)</span>
                                <strong>@e.Count</strong>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        <section class="merc-usage__section" aria-labelledby="clients-heading">
            <header class="merc-usage__section-heading merc-usage__section-heading--standalone">
                <div>
                    <span class="merc-usage__eyebrow">Apps</span>
                    <h2 id="clients-heading">OAuth-klienter</h2>
                    <p>Akkumuleret aktivitet og seneste kontakt pr. registreret klient.</p>
                </div>
            </header>

            @if (_summary.ByClient.Count == 0)
            {
                <div class="merc-panel merc-usage__empty">Ingen klient-brug registreret endnu.</div>
            }
            else
            {
                <div class="merc-usage__clients">
                    @foreach (var c in _summary.ByClient)
                    {
                        <article class="merc-panel merc-usage__client-card">
                            <header>
                                <span class="merc-users__provider-logo merc-users__provider-logo--oauth">
                                    <ProviderLogo Provider="oauth" />
                                </span>
                                <span class="merc-usage__client-name">
                                    <strong>@c.Name</strong>
                                    <code>@c.ClientId</code>
                                </span>
                                <span class="merc-usage__client-users"><strong>@c.DistinctUsers</strong> @(c.DistinctUsers == 1 ? "bruger" : "brugere")</span>
                            </header>
                            <dl class="merc-usage__client-metrics">
                                <div><dt>Authorize</dt><dd>@c.TotalAuthorizes</dd></div>
                                <div><dt>Token</dt><dd>@c.TotalTokenExchanges</dd></div>
                                <div><dt>Refresh</dt><dd>@c.TotalRefreshes</dd></div>
                            </dl>
                            <footer>Sidst set <strong>@FormatLocal(c.LastSeenAtUtc)</strong></footer>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="merc-panel merc-usage__panel merc-usage__recent" aria-labelledby="recent-heading">
            <header class="merc-usage__section-heading">
                <div>
                    <span class="merc-usage__eyebrow">Live spor</span>
                    <h2 id="recent-heading">Seneste hændelser</h2>
                </div>
                <span class="merc-usage__heading-meta">Seneste @_summary.RecentEvents.Count</span>
            </header>
            <div class="merc-usage__table-wrap">
                <table class="table table-sm merc-usage__table merc-usage__table--events">
                    <thead>
                    <tr>
                        <th>Tid</th>
                        <th>Type</th>
                        <th>Bruger</th>
                        <th>Klient</th>
                        <th>Provider</th>
                        <th>Login</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var e in _summary.RecentEvents)
                    {
                        <tr>
                            <td>@FormatLocal(e.CreatedAtUtc)</td>
                            <td><span class="merc-usage__event-badge merc-usage__event-badge--@EventTypeCategory(e.EventType)">@EventTypeLabel(e.EventType)</span></td>
                            <td>@(e.UserId is { } uid ? ShortId(uid) : "System")</td>
                            <td>@ClientLabel(e.ClientId)</td>
                            <td>
                                @if (EventProviderKey(e) is { } providerKey)
                                {
                                    <span class="merc-usage__provider-inline">
                                        <span class="merc-users__provider-logo merc-users__provider-logo--@ProviderCssKey(providerKey)">
                                            <ProviderLogo Provider="@providerKey" />
                                        </span>
                                        @ProviderLabel(providerKey)
                                    </span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td><code class="merc-usage__login-method">@(e.LoginMethod ?? "—")</code></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    private UsageSummaryVm? _summary;
    private string? _error;
    private bool _isRefreshing;
    private IReadOnlyDictionary<string, string> _clientNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

    private static readonly TimeZoneInfo DanishTz = TimeZoneInfo.FindSystemTimeZoneById(
        OperatingSystem.IsWindows() ? "Romance Standard Time" : "Europe/Copenhagen");

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task RetryAsync()
    {
        _error = null;
        _summary = null;
        return ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (_isRefreshing)
            return;

        _isRefreshing = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var since30 = DateTime.UtcNow.AddDays(-30);

            _clientNames = await db.ClientApps
                .AsNoTracking()
                .ToDictionaryAsync(c => c.ClientId, c => c.Name, StringComparer.OrdinalIgnoreCase);

            var clientRows = await db.UserClientUsages.AsNoTracking().ToListAsync();
            var byClient = clientRows
                .GroupBy(u => u.ClientId)
                .Select(g => new ClientAgg(
                    g.Key,
                    ClientLabel(g.Key),
                    g.Count(),
                    g.Sum(x => x.AuthorizeCount),
                    g.Sum(x => x.TokenExchangeCount),
                    g.Sum(x => x.RefreshCount),
                    g.Max(x => x.LastSeenAtUtc)))
                .OrderByDescending(x => x.LastSeenAtUtc)
                .ToList();

            var events30 = await db.AuthUsageEvents
                .AsNoTracking()
                .Where(e => e.CreatedAtUtc >= since30)
                .ToListAsync();

            var byEventType = events30
                .GroupBy(e => e.EventType)
                .Select(g => new EventTypeAgg(g.Key, g.Count()))
                .OrderByDescending(x => x.Count)
                .ToList();

            var byProvider = events30
                .Select(e => new ProviderEvent(
                    ProviderKeyForStats(e.EventType, e.Provider),
                    e.UserId))
                .Where(e => e.Key is not null)
                .GroupBy(e => e.Key!, StringComparer.OrdinalIgnoreCase)
                .Select(g => new ProviderAgg(
                    g.Key,
                    ProviderLabel(g.Key),
                    g.Count(),
                    g.Where(e => e.UserId is not null).Select(e => e.UserId!.Value).Distinct().Count()))
                .OrderByDescending(p => p.LoginCount)
                .ThenBy(p => p.Label, StringComparer.CurrentCultureIgnoreCase)
                .ToList();

            var recent = await db.AuthUsageEvents
                .AsNoTracking()
                .OrderByDescending(e => e.CreatedAtUtc)
                .Take(80)
                .Select(e => new EventVm(
                    e.CreatedAtUtc,
                    e.EventType,
                    e.UserId,
                    e.ClientId,
                    e.Provider,
                    e.LoginMethod))
                .ToListAsync();

            var activeUsers = events30
                .Where(e => e.UserId is not null)
                .Select(e => e.UserId!.Value)
                .Distinct()
                .Count();

            _summary = new UsageSummaryVm(
                byClient,
                byProvider,
                byEventType,
                recent,
                activeUsers,
                events30.Count);
            _error = null;
        }
        catch (Exception ex)
        {
            _summary = null;
            _error = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    private static string ShortId(Guid id) => id.ToString()[..8] + "…";

    private string ClientLabel(string? clientId)
    {
        if (string.IsNullOrWhiteSpace(clientId))
            return "—";

        return _clientNames.TryGetValue(clientId, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : clientId;
    }

    private static string? EventProviderKey(EventVm e) =>
        ProviderKeyForStats(e.EventType, e.Provider) ?? ProviderKeyFromLoginMethod(e.LoginMethod);

    private static string? ProviderKeyForStats(string eventType, string? provider)
    {
        if (eventType == AuthUsageEventTypes.ProviderLogin && !string.IsNullOrWhiteSpace(provider))
            return provider.Trim().ToLowerInvariant();
        if (eventType == AuthUsageEventTypes.PasswordLogin)
            return "password";
        if (eventType == AuthUsageEventTypes.PasskeyAuth)
            return "passkey";

        return null;
    }

    private static string? ProviderKeyFromLoginMethod(string? loginMethod) =>
        loginMethod?.Trim().ToLowerInvariant() switch
        {
            "password" => "password",
            "passkey" => "passkey",
            "google" => "google",
            "github" => "github",
            "discord" => "discord",
            "microsoft-work" => "microsoft",
            "microsoft-school" => "microsoft-edu",
            _ => null,
        };

    private static string ProviderLabel(string provider) => provider.Trim().ToLowerInvariant() switch
    {
        "password" => "E-mail / adgangskode",
        "passkey" => "Passkey",
        "google" => "Google",
        "microsoft" => "Microsoft 365",
        "microsoft-edu" => "Microsoft skolemail",
        "github" => "GitHub",
        "discord" => "Discord",
        _ => provider,
    };

    private static string ProviderCssKey(string provider) => provider.Trim().ToLowerInvariant() switch
    {
        "microsoft-edu" => "microsoft",
        "password" or "passkey" or "google" or "microsoft" or "github" or "discord" => provider.Trim().ToLowerInvariant(),
        _ => "other",
    };

    private static string EventTypeLabel(string eventType) => eventType switch
    {
        AuthUsageEventTypes.ProviderLogin => "Provider-login",
        AuthUsageEventTypes.PasswordLogin => "Password-login",
        AuthUsageEventTypes.PasswordSignup => "Oprettelse",
        AuthUsageEventTypes.PasswordLink => "Password tilknyttet",
        AuthUsageEventTypes.MfaTotpVerify => "TOTP bekræftet",
        AuthUsageEventTypes.MfaRecoveryUsed => "Recovery-kode",
        AuthUsageEventTypes.PasskeyAuth => "Passkey-login",
        AuthUsageEventTypes.PasskeyRegister => "Passkey oprettet",
        AuthUsageEventTypes.OAuthAuthorize => "OAuth authorize",
        AuthUsageEventTypes.OAuthTokenExchange => "Token udstedt",
        AuthUsageEventTypes.OAuthRefresh => "Token refresh",
        AuthUsageEventTypes.AccountLink => "Konto tilknyttet",
        _ => eventType.Replace('_', ' '),
    };

    private static string EventTypeCategory(string eventType)
    {
        if (eventType.StartsWith("oauth_", StringComparison.Ordinal))
            return "oauth";
        if (eventType.StartsWith("mfa_", StringComparison.Ordinal) || eventType.StartsWith("passkey_", StringComparison.Ordinal))
            return "security";
        if (eventType is AuthUsageEventTypes.ProviderLogin or AuthUsageEventTypes.PasswordLogin)
            return "login";
        return "account";
    }

    private static string FormatLocal(DateTime utc)
    {
        var local = TimeZoneInfo.ConvertTimeFromUtc(
            utc.Kind == DateTimeKind.Utc ? utc : DateTime.SpecifyKind(utc, DateTimeKind.Utc),
            DanishTz);
        return local.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.GetCultureInfo("da-DK"));
    }

    private sealed record UsageSummaryVm(
        IReadOnlyList<ClientAgg> ByClient,
        IReadOnlyList<ProviderAgg> ByProvider,
        IReadOnlyList<EventTypeAgg> ByEventType,
        IReadOnlyList<EventVm> RecentEvents,
        int ActiveUsers30,
        int TotalEvents30);

    private sealed record ClientAgg(
        string ClientId,
        string Name,
        int DistinctUsers,
        int TotalAuthorizes,
        int TotalTokenExchanges,
        int TotalRefreshes,
        DateTime LastSeenAtUtc);

    private sealed record ProviderEvent(string? Key, Guid? UserId);

    private sealed record ProviderAgg(string Key, string Label, int LoginCount, int DistinctUsers);

    private sealed record EventTypeAgg(string EventType, int Count);

    private sealed record EventVm(
        DateTime CreatedAtUtc,
        string EventType,
        Guid? UserId,
        string? ClientId,
        string? Provider,
        string? LoginMethod);
}
